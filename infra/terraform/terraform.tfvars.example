# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
# Secret tokens should come from the environment instead:
#   export TF_VAR_do_token=...           # DigitalOcean API token
#   export TF_VAR_cloudflare_api_token=... # Cloudflare token (Zone:DNS:Edit)

cloudflare_zone_id = "your-cloudflare-zone-id"
domain             = "faceratioops.skyshine.online"

region       = "sgp1"
droplet_size = "s-1vcpu-1gb"

# Fingerprints of SSH keys already uploaded to your DigitalOcean account.
ssh_key_fingerprints = [
  "aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99",
]

# Lock SSH to your own IP. Replace before applying.
ssh_allowed_cidrs = ["203.0.113.10/32"]
