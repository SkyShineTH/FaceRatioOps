# Safe production defaults for the DigitalOcean manual deployment.
# Copy to .env.production on the Droplet and review before starting the service.
APP_NAME=FaceRatioOps
APP_VERSION=0.2.0
ENVIRONMENT=production
LOG_LEVEL=INFO
MAX_UPLOAD_BYTES=5242880
MAX_IMAGE_PIXELS=12000000
MAX_DETECTED_FACES=2
MIN_DETECTION_CONFIDENCE=0.5
