# Safe monitoring defaults for local or SSH-tunneled Grafana access.
# Copy to .env.monitoring on the Droplet and replace the password before use.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=replace-with-a-long-random-password
GF_USERS_ALLOW_SIGN_UP=false
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false
